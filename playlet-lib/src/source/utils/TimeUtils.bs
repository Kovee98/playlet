import "Types.bs"

namespace TimeUtils

    ' Helper function convert seconds to [hh:]mm:ss format
    ' GetFormattedTime(138) returns 2:18
    function GetFormattedTime(length as dynamic) as string
        if length = invalid or length <= 0
            return ""
        end if

        hours = length \ 3600
        minutes = (length \ 60) mod 60
        seconds = length mod 60

        seconds = seconds.ToStr("%02d")

        if hours > 0
            minutes = minutes.ToStr("%02d")
        else
            minutes = minutes.ToStr()
        end if

        formattedTime = minutes + ":" + seconds

        if hours > 0
            formattedTime = hours.ToStr() + ":" + formattedTime
        end if

        return formattedTime
    end function

    function Now() as object
        this = m.now
        if this = invalid
            this = CreateObject("roDateTime")
            m.now = this
        end if
        this.mark()
        return this
    end function

    ' Estimates a Unix timestamp from English relative text such as "3 hours ago"
    ' or "Streamed 2 days ago". Returns invalid when the text can't be parsed.
    function EstimateTimestampFromRelativeText(text as dynamic, referenceTime as integer) as dynamic
        if not IsString(text) or text = ""
            return invalid
        end if
        regex = CreateObject("roRegex", "(\d+)\s*(second|sec|minute|min|hour|hr|day|week|wk|month|mo|year|yr)s?\.?\s+ago", "i")
        match = regex.Match(text)
        if match.Count() < 3
            return invalid
        end if
        unit = LCase(match[2])
        seconds = 1
        if unit = "minute" or unit = "min"
            seconds = 60
        else if unit = "hour" or unit = "hr"
            seconds = 3600
        else if unit = "day"
            seconds = 86400
        else if unit = "week" or unit = "wk"
            seconds = 604800
        else if unit = "month" or unit = "mo"
            seconds = 2592000
        else if unit = "year" or unit = "yr"
            seconds = 31536000
        end if
        return referenceTime - match[1].ToInt() * seconds
    end function

    function RFC1123_Date(when as object) as string
        wd = when.getWeekday().left(3)
        dom = when.getDayOfMonth()
        mon = Ucase(TimeUtils.MonthStr(when.getMonth()).left(3))
        yr = when.getYear()
        hr = when.getHours()
        mn = when.getMinutes()
        sc = when.getSeconds()
        date = `${wd}, ${dom} ${mon} ${yr} ${hr}:${mn}:${sc} GMT"`
        return date
    end function

    function MonthStr(mNum as integer) as string
        ma = m.Num2Month
        if ma = invalid
            ma = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
            m.Num2Month = ma
        end if
        return ValidString(ma[mNum - 1])
    end function

end namespace
