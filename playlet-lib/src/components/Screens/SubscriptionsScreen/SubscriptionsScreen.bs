import "pkg:/components/ChannelView/ChannelUtils.bs"
import "pkg:/components/ContentNode/ProfileContentAuthTokenUtils.types.bs"
import "pkg:/components/ContextMenu/ContextMenuUtils.bs"
import "pkg:/components/JobSystem/Jobs.bs"
import "pkg:/components/JobSystem/JobSystem.bs"
import "pkg:/components/Navigation/LongPress.bs"
import "pkg:/components/Navigation/Navigation.bs"
import "pkg:/components/Services/Invidious/InvidiousToContentNode.bs"
import "pkg:/components/VideoFeed/FeedLoadState.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/MathUtils.bs"
import "pkg:/source/utils/RegistryUtils.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/SubscriptionChannelsUtils.bs"
import "pkg:/source/utils/TimeUtils.bs"
import "pkg:/source/utils/Types.bs"

' Loaded channel feeds are reused for instant switching, and are dropped after this
' long or when the channel has a newer upload than the cached copy.
const FEED_CACHE_SECONDS = 600
' Number of channels above and below the selected one whose first page is preloaded.
const PREFETCH_DISTANCE = 2
const PREFETCH_THUMBNAILS_PER_FEED = 6
const PREFETCH_POSTER_COUNT = 24
' Watch history (progress bars and watch counts) is reloaded at most this often.
const WATCH_HISTORY_CACHE_SECONDS = 600

function Init()
    m.grid = m.top.FindNode("grid")
    m.status = m.top.FindNode("status")
    m.refreshButton = m.top.FindNode("refreshButton")
    m.channels = m.top.FindNode("channels")
    m.channelsStatus = m.top.FindNode("channelsStatus")
    m.feedTitle = m.top.FindNode("feedTitle")
    m.selectedChannelId = ""
    m.selectedChannelTitle = ""
    m.feedCache = {}
    m.channelUploads = {}
    m.watchProgress = {}
    m.watchCounts = {}
    m.historyLoadedAt = invalid
    m.seenState = invalid

    ' Background loads report here instead of the screen, so their failures stay silent.
    m.prefetchRowList = CreateObject("roSGNode", "Node")
    m.prefetchRowList.AddFields({ someContentReady: false, onError: "", dispose: true })

    ' Hidden posters warm the texture cache for preloaded feeds' first thumbnails.
    m.thumbnailPrefetch = m.top.FindNode("thumbnailPrefetch")
    m.nextPrefetchPoster = 0
    for index = 1 to PREFETCH_POSTER_COUNT
        poster = m.thumbnailPrefetch.CreateChild("Poster")
        poster.width = 350
        poster.height = 196
        poster.loadDisplayMode = "scaleToZoom"
    end for
end function

function OnNodeReady()
    SetNavigation(invalid, RemoteKeys.Back, m.navBar)
    SetNavigation(m.refreshButton, RemoteKeys.Left, m.channels)
    SetNavigation(m.refreshButton, RemoteKeys.Down, m.grid)
    m.grid.ObserveField("itemFocused", FuncName(OnItemFocused))
    m.grid.ObserveField("itemSelected", FuncName(OnItemSelected))
    m.channels.ObserveField("itemFocused", FuncName(OnChannelFocused))
    m.top.ObserveField("onError", FuncName(OnFeedError))
    m.refreshButton.ObserveField("buttonSelected", FuncName(OnRefreshSelected))
    m.profilesService.ObserveField("currentProfileChanged", FuncName(OnProfileChanged))
    m.top.ObserveField("visible", FuncName(OnVisibleChange))
    InitializeLongPress(["OK"])
    Refresh(invalid)
end function

function OnVisibleChange()
    if m.top.visible
        Refresh(invalid)
    else
        CancelLoad()
        CancelPrefetch()
        CancelChannelsLoad()
        CancelHistoryLoad()
    end if
end function

function OnProfileChanged()
    m.selectedChannelId = ""
    m.selectedChannelTitle = ""
    ClearFeedCache()
    Refresh(invalid)
end function

function OnRefreshSelected()
    ForceRefresh(invalid)
end function

function ForceRefresh(_unused as dynamic)
    ClearFeedCache()
    m.historyLoadedAt = invalid
    Refresh(invalid)
end function

function ClearFeedCache()
    CancelLoad()
    CancelPrefetch()
    m.feedCache = {}
end function

function CancelLoad()
    if m.loadJob <> invalid
        m.loadJob.cancel = true
        JobSystem.UnobserveCallback(m.loadJob)
        m.loadJob = invalid
        DropFeed(m.loadKey)
    end if
end function

function CancelPrefetch()
    if m.prefetchJob <> invalid
        m.prefetchJob.cancel = true
        JobSystem.UnobserveCallback(m.prefetchJob)
        m.prefetchJob = invalid
        DropFeed(m.prefetchKey)
    end if
end function

' A cancelled load may leave pagination half-updated, so it is reloaded from scratch.
function DropFeed(key as dynamic)
    if IsString(key)
        m.feedCache.Delete(key)
    end if
end function

function CancelChannelsLoad()
    if m.channelsJob <> invalid
        m.channelsJob.cancel = true
        JobSystem.UnobserveCallback(m.channelsJob)
        m.channelsJob = invalid
    end if
end function

function CancelHistoryLoad()
    if m.historyJob <> invalid
        m.historyJob.cancel = true
        JobSystem.UnobserveCallback(m.historyJob)
        m.historyJob = invalid
    end if
end function

function Refresh(_unused as dynamic) as void
    CancelChannelsLoad()
    profile = m.profilesService.currentProfile
    profileId = ""
    if profile <> invalid
        profileId = profile.id
    end if
    if m.channelProfileId <> profileId or m.channels.content = invalid
        m.channelProfileId = profileId
        m.selectedChannelId = ""
        m.selectedChannelTitle = ""
        m.channelUploads = {}
        m.seenState = invalid
        ClearFeedCache()
        CancelHistoryLoad()
        m.watchProgress = {}
        m.watchCounts = {}
        m.historyLoadedAt = invalid
        m.settingChannels = true
        content = CreateObject("roSGNode", "ContentNode")
        allItem = content.CreateChild("ContentNode")
        allItem.title = Tr(Locale.Subscriptions.All)
        allItem.id = ""
        allItem.HDPosterUrl = "pkg:/images/icons/subscriptions.png"
        m.channels.content = content
        m.settingChannels = false
    end if
    m.channelsStatus.text = ""
    m.channels.visible = false
    RefreshFeed()
    if not m.top.focusable or not m.top.visible
        return
    end if
    m.channels.visible = true
    m.channelsStatus.text = Tr(Locale.Subscriptions.Loading)
    m.channelsJob = JobSystem.CreateCallback(OnChannelsLoaded)
    JobSystem.QueueJob(m.jobQueue, Jobs.SubscriptionChannelsJob, { invidious: m.invidious, watchCounts: m.watchCounts }, m.channelsJob)
    LoadWatchHistory()
end function

' Runs alongside the channel list so neither waits for the other.
function LoadWatchHistory() as void
    if m.historyJob <> invalid
        return
    end if
    if m.historyLoadedAt <> invalid and TimeUtils.Now().AsSeconds() - m.historyLoadedAt < WATCH_HISTORY_CACHE_SECONDS
        return
    end if
    m.historyJob = JobSystem.CreateCallback(OnWatchHistoryLoaded)
    JobSystem.QueueJob(m.jobQueue, Jobs.SubscriptionWatchHistoryJob, { invidious: m.invidious }, m.historyJob)
end function

function OnWatchHistoryLoaded(event as object) as void
    if m.historyJob = invalid or event.GetNode() <> m.historyJob.id
        return
    end if
    JobSystem.UnobserveCallback(event.GetRoSGNode())
    m.historyJob = invalid
    info = event.GetInfo()
    if info.cancel or not info.success or not IsAssociativeArray(info.data)
        return
    end if
    m.historyLoadedAt = TimeUtils.Now().AsSeconds()
    m.watchProgress = ValidAssociativeArray(info.data.progress)
    m.watchCounts = ValidAssociativeArray(info.data.counts)
    ApplyWatchProgressToGrid()
    ResortChannels()
end function

' Applies new watch counts to the channel order, unless the user is browsing the
' channel list (then the new order is used on the next load).
function ResortChannels() as void
    content = m.channels.content
    if content = invalid or content.GetChildCount() < 3 or m.channelsJob <> invalid
        return
    end if
    if m.channels.IsInFocusChain() and m.channels.itemFocused > 0
        return
    end if
    items = content.GetChildren(-1, 0)
    allItem = items.Shift()
    entries = []
    for each item in items
        entries.Push({ authorId: item.id, latestUploadTimestamp: item.latestUploadTimestamp, node: item })
    end for
    sorted = SubscriptionChannelsUtils.Sort(entries, m.watchCounts)
    changed = false
    for index = 0 to sorted.Count() - 1
        if sorted[index].authorId <> items[index].id
            changed = true
            exit for
        end if
    end for
    if not changed
        return
    end if
    m.settingChannels = true
    newContent = CreateObject("roSGNode", "ContentNode")
    newContent.AppendChild(allItem)
    selectedIndex = 0
    for each entry in sorted
        newContent.AppendChild(entry.node)
        if entry.authorId = m.selectedChannelId
            selectedIndex = newContent.GetChildCount() - 1
        end if
    end for
    m.channels.content = newContent
    m.channels.jumpToItem = selectedIndex
    m.settingChannels = false
end function

function OnChannelsLoaded(event as object) as void
    if m.channelsJob = invalid or event.GetNode() <> m.channelsJob.id
        return
    end if
    JobSystem.UnobserveCallback(event.GetRoSGNode())
    m.channelsJob = invalid
    info = event.GetInfo()
    if info.cancel
        return
    end if
    if not info.success
        LogError("Failed to load subscription channels:", info.error)
        m.channelsStatus.text = Tr(Locale.Subscriptions.ChannelsError)
        return
    end if
    m.settingChannels = true
    selectedIndex = 0
    channels = info.data.channels
    m.seenState = SubscriptionChannelsUtils.UpdateUnseen(channels, LoadSeenState(m.channelProfileId), TimeUtils.Now().AsSeconds())
    SaveSeenState()
    m.channelUploads = {}
    content = CreateObject("roSGNode", "ContentNode")
    allItem = content.CreateChild("ContentNode")
    allItem.title = Tr(Locale.Subscriptions.All)
    allItem.HDPosterUrl = "pkg:/images/icons/subscriptions.png"
    for each channel in channels
        item = content.CreateChild("ContentNode")
        item.id = channel.authorId
        item.title = ValidString(channel.author)
        item.HDPosterUrl = InvidiousContent.GetChannelThumbnail(channel.authorThumbnails)
        item.AddFields({
            latestUploadTimestamp: ValidInt(channel.latestUploadTimestamp)
            unseen: ValidBool(channel.unseen)
        })
        m.channelUploads[channel.authorId] = item.latestUploadTimestamp
        if item.title = ""
            item.title = channel.authorId
        end if
        if item.id = m.selectedChannelId
            selectedIndex = content.GetChildCount() - 1
            m.selectedChannelTitle = item.title
        end if
    end for
    m.channels.content = content
    m.channels.jumpToItem = selectedIndex
    m.settingChannels = false
    if m.channels.IsInFocusChain()
        MarkChannelSeen(content.GetChild(selectedIndex))
    end if
    m.channelsStatus.text = ""
    if info.data.uploadDatesIncomplete = true
        m.channelsStatus.text = Tr(Locale.Subscriptions.UploadDatesIncomplete)
    end if
    if selectedIndex = 0 and m.selectedChannelId <> ""
        m.selectedChannelId = ""
        m.selectedChannelTitle = ""
        RefreshFeed()
    else
        SchedulePrefetch()
    end if
end function

function LoadSeenState(profileId as string) as dynamic
    if profileId = ""
        return invalid
    end if
    store = StringUtils.ParseJsonSafe(ValidString(RegistryUtils.Read(RegistryUtils.SUBSCRIPTION_SEEN)))
    if not IsAssociativeArray(store)
        return invalid
    end if
    return store[profileId]
end function

function SaveSeenState() as void
    if m.channelProfileId = "" or m.seenState = invalid
        return
    end if
    store = StringUtils.ParseJsonSafe(ValidString(RegistryUtils.Read(RegistryUtils.SUBSCRIPTION_SEEN)))
    if not IsAssociativeArray(store)
        store = {}
    end if
    store[m.channelProfileId] = m.seenState
    RegistryUtils.Write(RegistryUtils.SUBSCRIPTION_SEEN, FormatJson(store))
end function

function MarkChannelSeen(item as dynamic) as void
    if item = invalid or not ValidBool(item.unseen)
        return
    end if
    item.unseen = false
    if SubscriptionChannelsUtils.MarkSeen(m.seenState, item.id, item.latestUploadTimestamp)
        SaveSeenState()
    end if
end function

function OnChannelFocused() as void
    if m.settingChannels
        return
    end if
    item = m.channels.content.GetChild(m.channels.itemFocused)
    MarkChannelSeen(item)
    if item <> invalid and item.id <> m.selectedChannelId
        m.selectedChannelId = item.id
        m.selectedChannelTitle = item.title
        RefreshFeed()
    end if
end function

function RefreshFeed() as void
    CancelLoad()
    profile = m.profilesService.currentProfile
    hasProfile = profile <> invalid
    needsReauth = false
    if hasProfile
        needsReauth = profile.authState = ProfileContentAuthTokenUtils.ProfileAuthState.NeedsReauth
    end if

    m.top.focusable = hasProfile and not needsReauth
    m.refreshButton.visible = m.top.focusable
    m.grid.visible = false
    m.grid.focusable = false
    m.grid.content = CreateObject("roSGNode", "ContentNode")
    m.status.visible = true
    m.feedFailed = false

    if not hasProfile
        m.status.text = Tr(Locale.Subscriptions.SignIn)
    else if needsReauth
        m.status.text = Tr(Locale.Dialogs.ProfileNeedsReauthMessage)
    else
        m.status.text = Tr(Locale.Subscriptions.Loading)
    end if

    if not m.top.focusable or not m.top.visible
        if m.top.IsInFocusChain()
            NodeSetFocus(m.navBar, true)
        end if
        return
    end if

    m.feedTitle.text = Tr(Locale.Subscriptions.All)
    if m.selectedChannelId <> ""
        m.feedTitle.text = m.selectedChannelTitle
    end if
    key = FeedKey(m.selectedChannelId)
    if m.prefetchJob <> invalid and m.prefetchKey = key
        ' The channel is already preloading, so show it as soon as that finishes.
        m.loadJob = m.prefetchJob
        m.loadKey = key
        m.prefetchJob = invalid
        m.feed = m.feedCache[key].feed
    else
        m.feed = GetCachedFeed(m.selectedChannelId)
        if m.feed = invalid
            m.feed = CreateFeed(m.selectedChannelId, m.selectedChannelTitle)
            m.feedCache[key] = { feed: m.feed, savedAt: TimeUtils.Now().AsSeconds() }
        end if
    end if
    AppendGridItems()
    if m.feed.GetChildCount() = 0
        LoadNextPage()
    end if
    if m.loadJob = invalid
        UpdateFeedStatus()
        SchedulePrefetch()
    end if
    if m.grid.IsInFocusChain()
        NodeSetFocus(m.refreshButton, true)
    end if
end function

function FeedKey(channelId as string) as string
    return "channel:" + channelId
end function

function CreateFeed(channelId as string, channelTitle as string) as object
    feed = CreateObject("roSGNode", "FeedContentNode")
    feed.title = Tr(Locale.Feed.Subscriptions)
    feed.loadState = FeedLoadState.None
    feed.feedSourcesIndex = 0
    source = {
        id: "inv_auth_feed"
        title: Tr(Locale.Feed.Subscriptions)
        apiType: "Invidious"
        endpoint: "auth_feed"
        state: { loadState: FeedLoadState.None }
    }
    if channelId <> ""
        source.id = "subscription_channel"
        source.title = channelTitle
        source.endpoint = "channel_videos"
        source.pathParams = { ucid: channelId }
        source.queryParams = { sort_by: "newest" }
    end if
    feed.feedSources = [source]
    return feed
end function

function GetCachedFeed(channelId as string) as dynamic
    key = FeedKey(channelId)
    entry = m.feedCache[key]
    if entry = invalid
        return invalid
    end if
    isFresh = SubscriptionChannelsUtils.IsFeedCacheFresh(entry.savedAt, m.channelUploads[channelId], TimeUtils.Now().AsSeconds(), FEED_CACHE_SECONDS)
    if not isFresh or FeedHasError(entry.feed)
        m.feedCache.Delete(key)
        return invalid
    end if
    return entry.feed
end function

function FeedHasError(feed as object) as boolean
    for each source in feed.feedSources
        if IsAssociativeArray(source.state) and source.state.loadState = FeedLoadState.Error
            return true
        end if
    end for
    return false
end function

function LoadNextPage() as void
    if m.loadJob <> invalid or not m.top.visible or m.feed = invalid
        return
    end if
    if m.feed.loadState <> FeedLoadState.None and m.feed.loadState <> FeedLoadState.LoadedPage
        return
    end if
    m.feed.loadState = FeedLoadState.Loading
    m.loadKey = FeedKey(m.selectedChannelId)
    m.loadJob = JobSystem.CreateCallback(OnFeedJobDone)
    JobSystem.QueueJob(m.jobQueue, Jobs.VideoRowListRowContentJob, {
        rowList: m.top
        feedContentNode: m.feed
        invidious: m.invidious
    }, m.loadJob)
end function

' Preloads the first page of nearby channels, one at a time, once the visible feed is idle.
function SchedulePrefetch() as void
    if m.prefetchJob <> invalid or m.loadJob <> invalid or not m.top.visible or m.channels.content = invalid
        return
    end if
    content = m.channels.content
    focused = m.channels.itemFocused
    for distance = 1 to PREFETCH_DISTANCE
        for each direction in [1, -1]
            item = content.GetChild(focused + direction * distance)
            if item = invalid or GetCachedFeed(item.id) <> invalid
                continue for
            end if
            feed = CreateFeed(item.id, item.title)
            feed.loadState = FeedLoadState.Loading
            m.prefetchKey = FeedKey(item.id)
            m.feedCache[m.prefetchKey] = { feed: feed, savedAt: TimeUtils.Now().AsSeconds() }
            m.prefetchJob = JobSystem.CreateCallback(OnFeedJobDone)
            JobSystem.QueueJob(m.jobQueue, Jobs.VideoRowListRowContentJob, {
                rowList: m.prefetchRowList
                feedContentNode: feed
                invidious: m.invidious
            }, m.prefetchJob)
            return
        end for
    end for
end function

function OnFeedJobDone(event as object) as void
    node = event.GetNode()
    isCurrent = m.loadJob <> invalid and node = m.loadJob.id
    isPrefetch = m.prefetchJob <> invalid and node = m.prefetchJob.id
    if not isCurrent and not isPrefetch
        return
    end if
    JobSystem.UnobserveCallback(event.GetRoSGNode())
    if isCurrent
        key = m.loadKey
        m.loadJob = invalid
    else
        key = m.prefetchKey
        m.prefetchJob = invalid
    end if
    entry = m.feedCache[key]
    if event.GetInfo().cancel
        DropFeed(key)
        return
    end if
    ' A job can also finish without loading anything (e.g. a removed feed).
    if entry <> invalid and (FeedHasError(entry.feed) or entry.feed.loadState = FeedLoadState.Loading)
        DropFeed(key)
        if isCurrent
            m.feedFailed = true
        end if
    end if

    if isCurrent
        AppendGridItems()
        UpdateFeedStatus()
    else if entry <> invalid
        PrefetchThumbnails(entry.feed)
    end if
    SchedulePrefetch()
end function

function AppendGridItems()
    content = m.grid.content
    for index = content.GetChildCount() to m.feed.GetChildCount() - 1
        content.AppendChild(CloneWithProgress(m.feed.GetChild(index)))
    end for
end function

function UpdateFeedStatus()
    hasVideos = m.grid.content.GetChildCount() > 0
    m.grid.visible = hasVideos
    m.grid.focusable = hasVideos
    m.status.visible = not hasVideos or m.feedFailed
    if m.feedFailed
        m.status.text = Tr(Locale.Dialogs.FailedToLoadFeed)
    else if not hasVideos
        if m.loadJob <> invalid
            m.status.text = Tr(Locale.Subscriptions.Loading)
        else if m.selectedChannelId = ""
            m.status.text = Tr(Locale.Subscriptions.Empty)
        else
            m.status.text = Tr(Locale.Subscriptions.ChannelEmpty)
        end if
    end if
end function

' Grid items are clones, so watch progress can be updated without touching cached feeds.
function CloneWithProgress(item as object) as object
    clone = item.Clone(false)
    percent = WatchProgressFor(clone)
    if percent <> invalid
        clone.percentDurationWatched = percent
    end if
    return clone
end function

function WatchProgressFor(item as object) as dynamic
    if not item.HasField("percentDurationWatched")
        return invalid
    end if
    return m.watchProgress[ValidString(item.videoId)]
end function

function ApplyWatchProgressToGrid() as void
    content = m.grid.content
    if content = invalid
        return
    end if
    for index = 0 to content.GetChildCount() - 1
        item = content.GetChild(index)
        percent = WatchProgressFor(item)
        if percent <> invalid and item.percentDurationWatched <> percent
            ' Replacing the node makes the visible cell redraw its progress bar.
            content.ReplaceChild(CloneWithProgress(item), index)
        end if
    end for
end function

function PrefetchThumbnails(feed as object)
    posters = m.thumbnailPrefetch.GetChildren(-1, 0)
    count = MathUtils.Min(feed.GetChildCount(), PREFETCH_THUMBNAILS_PER_FEED)
    for index = 0 to count - 1
        thumbnail = ValidString(feed.GetChild(index).thumbnail)
        if thumbnail <> ""
            posters[m.nextPrefetchPoster].uri = thumbnail
            m.nextPrefetchPoster = (m.nextPrefetchPoster + 1) mod posters.Count()
        end if
    end for
end function

function OnFeedError()
    m.feedFailed = true
    m.status.text = Tr(Locale.Dialogs.FailedToLoadFeed)
    m.status.visible = true
end function

function OnItemFocused()
    if m.grid.itemFocused >= m.grid.content.GetChildCount() - 6
        LoadNextPage()
    end if
end function

function OnItemSelected()
    LongPressHandler(RemoteKeys.Ok, true)
end function

function OnFocusChange()
    if m.top.focus
        NodeSetFocus(m.channels, true)
    end if
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if m.grid.IsInFocusChain()
        if key = RemoteKeys.Back and press
            NodeSetFocus(m.channels, true)
            return true
        end if
        if not (key = RemoteKeys.Ok and press)
            if LongPressHandler(key, press)
                return true
            end if
        end if
        item = m.grid.content.GetChild(m.grid.itemFocused)
        if key = RemoteKeys.OkLongPress and press
            ContextMenuUtils.Open([m.top, m.bookmarksService], m.appController, item)
            return true
        else if key = RemoteKeys.Ok and not press
            PlayVideo(item)
            return true
        else if key = RemoteKeys.Left and press and m.grid.itemFocused mod 3 = 0
            NodeSetFocus(m.channels, true)
            return true
        else if key = RemoteKeys.Up and press and m.grid.itemFocused < 3
            NodeSetFocus(m.refreshButton, true)
            return true
        end if
    end if
    if m.channels.IsInFocusChain() and press
        if key = RemoteKeys.Left
            NodeSetFocus(m.navBar, true)
            return true
        else if key = RemoteKeys.Right
            if m.grid.focusable
                NodeSetFocus(m.grid, true)
            else
                NodeSetFocus(m.refreshButton, true)
            end if
            return true
        end if
    end if
    return NavigationKeyHandler(key, press).handled
end function

function PlayVideo(item as object)
    m.videoQueue.playVideo = item
end function

function QueueVideo(item as object)
    m.videoQueue@.FuncAddToQueueVideo(item)
end function

function OpenVideoChannel(item as object)
    channel = InvidiousContent.ToChannelContentNode(invalid, { authorId: item.authorId })
    ChannelUtils.Open(channel)
end function

function GetContextMenuOptionsForItem(item as object) as object
    options = [
        ContextMenuUtils.CreateOption(Tr(Locale.ContextMenu.PlayVideo), m.top, "PlayVideo", [item])
        ContextMenuUtils.CreateOption(Tr(Locale.ContextMenu.QueueVideo), m.top, "QueueVideo", [item])
    ]
    if not StringUtils.IsNullOrEmpty(item.authorId)
        options.Push(ContextMenuUtils.CreateOption(Tr(Locale.ContextMenu.OpenChannel), m.top, "OpenVideoChannel", [item]))
    end if
    options.Push(ContextMenuUtils.CreateOption(Tr(Locale.Buttons.Refresh), m.top, "ForceRefresh", [invalid]))
    return options
end function
